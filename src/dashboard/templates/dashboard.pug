doctype html
html
  head
    title Snallabot Dashboard
    link(rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" integrity="sha384-QWTKZyjpPEjISv5WaRU9OFeRpok6YctnYmDr5pNlyT2bRjXh0JMhjY6hW+ALEwIH" crossOrigin="anonymous")
    link(rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootswatch/5.3.3/sandstone/bootstrap.min.css" crossorigin="anonymous" referrerpolicy="no-referrer")
    script(src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.min.js" integrity="sha384-0pUGZvbkm6XF6gxjEnlmuGrJXVbNuzT9qBBavbLwCsOGabYfZo0T0to5eqruptLy" crossOrigin="anonymous")
body
  .div(class="container-fluid" style="margin-top: 8px;")
    h4 #{leagueName} Snallabot Dashboard
    .row.align-items-center
     .col-auto
       div
         div #{seasonWeekType}, Year #{seasonInfo.calendarYear}
         div Current Week: #{seasonInfo.weekTitle} #{seasonInfo.displayWeek > 0 ? seasonInfo.displayWeek : ''}
         div Last Advance: #{lastAdvance.toDateString()}
     .col.text-center
       .input-group
         select.form-select#exportSelect
           each key in Object.keys(exportOptions)
             option(value=key) #{key}
         button.btn.btn-primary#exportBtn(type="button") Export
     .col-auto.text-center
       button.btn.btn-danger#unlinkBtn(type="button") Unlink League
    div#exportFeedback
    .table-responsive
      table.table.table-hover.table-sm.caption-top
        caption List of Export Url's - this service pushes exported data straight through to these urls, it does not store any of it itself
        thead.table-light
          tr
            th Url
            th(style="text-align: center;") League Info
            th(style="text-align: center;") Weekly Stats
            th(style="text-align: center;") Roster
            th(style="text-align: center;") Extra Data
            th(style="text-align: center;") Auto Update
            th(style="text-align: center;") Secret
            th(style="text-align: center;") Last Attempt
            th(style="text-align: center;") Last Success
            th(style="text-align: center;")
              button#addExportBtn.btn.btn-success(type="button") Add Export Url
        tbody#exportTableBody
          each exportDestination in exports
              tr
                td(class="export-url") #{exportDestination.url}
                td(style="text-align: center;")
                  input(type="checkbox", disabled=true, checked=exportDestination.leagueInfo )
                td(style="text-align: center;")
                  input(type="checkbox", disabled=true, checked=exportDestination.weeklyStats)
                td(style="text-align: center;")
                  input(type="checkbox", disabled=true, checked=exportDestination.rosters)
                td(style="text-align: center;")
                  input(type="checkbox", disabled=true, checked=exportDestination.extraData)
                td(style="text-align: center;")
                  input(type="checkbox", disabled=true, checked=exportDestination.autoUpdate)
                td(style="text-align: center;")
                  if exportDestination.hasSecret
                    span(class="badge bg-success") Set
                  else
                    span(class="badge bg-secondary") None
                td(style="text-align: center;") #{exportDestination.lastExportAttempt ? new Date(exportDestination.lastExportAttempt).toLocaleString() : 'Never'}
                td(style="text-align: center;") #{exportDestination.lastSuccessfulExport ? new Date(exportDestination.lastSuccessfulExport).toLocaleString() : 'Never'}
                td(style="text-align: center;")
                  if exportDestination.editable
                    button.btn.btn-outline-danger.btn-sm.remove-export-btn(type="button") Remove
    if discordEnabled
      div(class="card mb-3 shadow-sm")
        div(class="card-header bg-primary text-white")
          h5(class="mb-0") Connect Discord Server
        div(class="card-body")
          if discordsToConnect && discordsToConnect.length > 0
            form(action="/dashboard/connectDiscord" method="POST")
              div(class="mb-3")
                label(for="discordServerSelect" class="form-label") Select Discord Server
                select(class="form-select" id="discordServerSelect" name="guildId" required)
                  option(value="" selected disabled) Choose a server...
                  each discord in discordsToConnect
                    option(value=discord.guildId) #{discord.name}
              div(class="mb-3")
                input(type="hidden" name="leagueId" value=leagueId)
              button(type="submit" class="btn btn-primary") Connect Discord
          else
            div(class="text-center")
              p(class="mb-3") Authorize Discord to connect your league
              a(href=oauthUrl class="btn btn-primary")
                | Connect to Discord
    div(class="d-flex flex-column mt-3")
      div(class="flex-grow-1")
        each league in discordSettings
          div(class="flex-grow-1 mb-3")
            div(class="card h-100 shadow-sm w-100")
              div(class="card-header d-flex align-items-center bg-primary text-white")
                if league.icon
                  img(src=`https://cdn.discordapp.com/icons/${league.settings.guildId}/${league.icon}.png?size=64` class="rounded-circle me-3" style="width: 48px; height: 48px;")
                else
                  div(class="bg-secondary rounded-circle d-flex align-items-center justify-content-center me-3" style="width: 48px; height: 48px;")
                    i(class="fas fa-server text-white")
                div
                  h5(class="card-title mb-0") #{league.name}
                  small(class="text-white-50") Guild ID: #{league.settings.guildId}

              div(class="card-body")
                h6(class="text-muted mb-3") Command Configurations
                div(class="row g-2")
                  div(class="col-6")
                    div(class="d-flex justify-content-between align-items-center p-2 border rounded")
                      span Logger
                      if league.settings.commands.logger
                        span(class="badge bg-success") ✓ Set
                      else
                        span(class="badge bg-secondary") Not Set

                  div(class="col-6")
                    div(class="d-flex justify-content-between align-items-center p-2 border rounded")
                      span Game Channel
                      if league.settings.commands.game_channel
                        span(class="badge bg-success") ✓ Set
                      else
                        span(class="badge bg-secondary") Not Set

                  div(class="col-6")
                    div(class="d-flex justify-content-between align-items-center p-2 border rounded")
                      span Stream Count
                      if league.settings.commands.stream_count
                        span(class="badge bg-success") ✓ Set
                      else
                        span(class="badge bg-secondary") Not Set

                  div(class="col-6")
                    div(class="d-flex justify-content-between align-items-center p-2 border rounded")
                      span Broadcast
                      if league.settings.commands.broadcast
                        span(class="badge bg-success") ✓ Set
                      else
                        span(class="badge bg-secondary") Not Set

                  div(class="col-6")
                    div(class="d-flex justify-content-between align-items-center p-2 border rounded")
                      span Teams
                      if league.settings.commands.teams
                        span(class="badge bg-success") ✓ Set
                      else
                        span(class="badge bg-secondary") Not Set

                  div(class="col-6")
                    div(class="d-flex justify-content-between align-items-center p-2 border rounded")
                      span Waitlist
                      if league.settings.commands.waitlist
                        span(class="badge bg-success") ✓ Set
                      else
                        span(class="badge bg-secondary") Not Set
    .table-responsive
      table(class="table table-hover table-condensed caption-top" style="margin-top: 16px; margin-bottom: 16px;")
        caption Schedule for #{seasonInfo.weekTitle} #{seasonInfo.displayWeek > 0 ? seasonInfo.displayWeek : ''}
        thead.table-light
          tr
            th Game
            th Result
            th Number of Times Played
        tbody
          each seasonGame in gameScheduleHubInfo.leagueSchedule
            - const game = seasonGame.seasonGameInfo
            tr
              td #{game.isAwayHuman ? game.awayUserName : 'CPU'} #{game.awayCityName} #{game.awayName} (#{game.awayWin} - #{game.awayLoss}#{game.awayTie > 0 ? ' - ' + game.awayTie : ''}) at #{game.isHomeHuman ? game.homeUserName : 'CPU'} #{game.homeCityName} #{game.homeName} (#{game.homeWin} - #{game.homeLoss}#{game.homeTie > 0 ? ' - ' + game.homeTie : ''})
              td #{game.result || 'Not Played'}
              td #{game.numberTimesPlayed || 0}
script.
  // Set only when this page was loaded with ?key=... in the url - lets this
  // page's own buttons call its API-key-protected endpoints. Anonymous
  // visitors without the key simply can't trigger exports/config changes.
  window.__SYNC_KEY__ = !{JSON.stringify(apiKey || "").replace(/</g, '\\u003c')}
script(type='text/javascript', src='/dashboard_script.js')
