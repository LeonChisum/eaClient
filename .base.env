# Location of snallabot deployment, for dev this is the default
DEPLOYMENT_URL=localhost:3000

# Snallabot Sync API - required to use the trimmed-down standalone EA-connect
# + export deployment (see docs/standalone-sync-service.md). Protects the
# sync-trigger/config endpoints (/dashboard/league/:leagueId/export,
# exportStatus, updateExport, deleteExport, unlink). Requests must send it as
# `Authorization: Bearer <SYNC_API_KEY>`. There is no default - these routes
# reject all requests until this is set.
# SYNC_API_KEY=

# Comma-separated origins allowed as a `return_to` value on the EA-connect
# dashboard flow (GET /dashboard?return_to=..., see dashboard/routes.ts). Lets
# an external app (e.g. LeagueCard's /admin/ea-connect) send a commissioner
# here to do the one-time EA login, and get redirected back to its own
# `return_to` URL with `?leagueId=...` appended once they finish - instead of
# the leagueId only ever showing up in this service's own page. Fails closed:
# unset/empty means no return_to is ever honored (falls back to this
# service's own /dashboard/league/:leagueId redirect).
# ALLOWED_RETURN_TO_ORIGINS=

# Uncomment and fill in any of these to use that part of the bot. Only
# relevant if you're running the full snallabot deployment (Discord bot,
# Twitch/YouTube notifiers) rather than the standalone EA-sync service above -
# none of these are required for the standalone service.

# REQUIRED: Discord env, create your discord application in the development portal. Do not check these value into version control!
# PUBLIC_KEY=
# DISCORD_TOKEN=
# APP_ID=
# Optional, but probably a good idea
# CLIENT_SECRET=

# Optional
# set to true to turn off discord client that listens to reaction and role changes
# NO_CLIENT=

# These are all OPTIONAL

# GCP env, this is for firebase and google cloud storage. If not used, a firebase emulator is used and local file system is used
# The standalone EA-sync service still needs this - it's the only storage it
# uses, and only for EA credentials + destination config, never league
# content. MONGO_CONNECTION_URI (an alternate store for full league history,
# see src/db/mongo_db.ts) is irrelevant to the standalone deployment - it's
# only read by the Madden export ingestion webhook, which isn't mounted there.

# this is the JSON file of your service account. DO NOT CHECK THAT FILE INTO VERSION CONTROL
# SERVICE_ACCOUNT_FILE=
# this is the full JSON string of your service account. use this or the file whichever is easier
# SERVICE_ACCOUNT=
# Use google cloud storage, this would mean you need to setup the appopriate buckets as well
# USE_GCS= true or false

# Twitch env, this is for snallabot to receieve Twitch
# by default this would be DEPLOYMENT_URL/twitch/webhook
# TWITCH_CALLBACK_URL=
# from your Twitch developer account
# TWITCH_CLIENT_ID=
# from your Twitch developer account
# TWITCH_CLIENT_SECRET=
# a random secret you generate for Twitch, see Twitch EventSub https://dev.twitch.tv/docs/eventsub/handling-webhook-events/
# TWITCH_SECRET=

# Youtube env, this is for snallabot to retrieve youtube names
# YOUTUBE_API_KEY=

# Snallabot Specific envs
# optimize writes to firebase. Not recommended for self hosting
# USE_WRITE_HASHES=true or false
# number of exports to handle at once, default is 1
# QUEUE_CONCURRENCY=1

# Prometheus Metrics, pushgateway for script files. Optional
# PUSHGATEWAY_URL=